{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fideliza-o",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beeclub-data",
      "database_id": "eb310289-4e6b-452b-8615-539202ced79b"
    }
  ]
}
